{
  "manifest_version": "0.3",
  "name": "pocketsmith",
  "display_name": "PocketSmith",
  "version": "0.1.0",
  "description": "Query and manage your PocketSmith accounts, transactions, categories, and budgets.",
  "author": {
    "name": "Tim Ross"
  },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/mcp-server.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/mcp-server.js"],
      "env": {
        "POCKETSMITH_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "PocketSmith API Key",
      "description": "Create a developer key in PocketSmith under Settings > Security > Manage developer keys.",
      "required": true,
      "sensitive": true
    }
  },
  "keywords": ["pocketsmith", "finance", "budgeting", "transactions"]
}
